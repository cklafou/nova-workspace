# @nova: Exclude local dependencies and generated or private paths from automated source handling.
# .aignore — Paths excluded from AI file indexes, backups, and Drive sync.
# Reference exclusions; sync consumers also enforce their own built-in exclusions.
# watcher.py currently loads the repository-root .aignore at startup.
# Format: one path per line. Lines starting with # are comments.
# Prefix with workspace/ to target a specific subpath, or just a folder name
# to exclude it anywhere it appears in the tree.

# ── MODEL WEIGHTS ─────────────────────────────────────────────────────────────
# CRITICAL: Never index, read, or sync model weight files.
# The GGUF alone is 18GB — reading it will exhaust any AI's context window
# and blow out Google Drive storage. These files are loaded directly by
# llama.cpp and HuggingFace at runtime; no AI tool needs to see them.
models

# ── LARGE BINARY / GENERATED DIRS ─────────────────────────────────────────────
screenshots
backups
__pycache__
_build
nova_memory_db
prompt_cache

# ── MODEL UPDATER (general_tools/nova_updater, 2026-10-04) ──
# Runtime state and training scratch: changes here are not source and must not trigger autosave.
workspace/general_tools/nova_updater/state
workspace/Temp/updater

# Local Python environments are reproducible dependencies, never source.
.venv
venv
