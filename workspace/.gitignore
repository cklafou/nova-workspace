# @nova: Exclude local secrets, runtime state, generated files and large assets from Git.
# Large binaries — never commit
*.gguf
*.dll
*.exe
dist/
build/
_build/
llama/
models/
git_log_output.txt
*.log
__pycache__/
*.pyc
.env
nova_drive_token.json

# ── SECRETS (2026-07-20, Cole) ─────────────────────────────────────────────────────────
# "Secrets are fine in folders and files. All files with secrets MUST be excluded from
# file repository uploads though (git and drive currently)."
#
# This list is mirrored in general_tools/nova_sync/drive.py (EXCLUDE_FILES +
# SECRET_SUFFIXES). The two MUST agree — a credential excluded from git but not from Drive
# has still left the machine. audit_scripts.py::check_secret_exclusions asserts parity, so
# adding to one without the other is now a HIGH finding rather than a silent leak.
nova_gateway.json
client_secrets.json
memory/.auth_token
memory/nova_users.json

# Secret-shaped names, anywhere in the tree
*.pem
*.key
*.p12
*.pfx
*.keystore
*_token.json
*_secret.json
*_secrets.json
*.credentials.json

# Regenerable artifacts / launcher junk
.nova_app_profile*/
build_exe/

# Cleanup archive (relocated clutter — safe to delete)
_admin/_archive_2026-05-23/

# Temp folders live beside the thing they belong to. Never tracked. (2026-07-14)
**/Temp/

# LanceDB store — regenerable data, 1000+ files (2026-07-14)
nova_memory_db/
prompt_cache/

# Body-owned state after the portability migration; keep historic exclusions too.
nova_body/logs/
nova_body/memory/.auth_token
nova_body/memory/nova_users.json
nova_body/nova_memory_db/
nova_body/nova_config.json

# Runtime work queue: live state holding memory text and images, never source. (2026-10-03)
nova_body/memory/runtime_work.sqlite3*

# Avatar files are excluded from git (Cole, 2026-10-03). The avatar keeps its own verified
# checkpoint zips; the completed history repair removed previously tracked artifacts.
nova_body/SELF/Avatar/

# Model updater runtime state (decisions, plans, job history). Never source. (2026-10-04)
general_tools/nova_updater/state/
